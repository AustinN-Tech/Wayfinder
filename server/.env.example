# Copy to .env and fill in real values. .env is gitignored - never commit it.

# Where the Flask API is served from. Defaults to http://localhost:5000.
VITE_API_URL=

# Auth0 SPA application settings (public identifiers, not secrets).
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=

# MUST byte-match AUTH0_AUDIENCE in insitu/.env, or Auth0 issues a token the
# backend rejects and every protected request comes back 401.
VITE_AUTH0_AUDIENCE=
